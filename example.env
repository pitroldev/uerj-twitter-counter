#################################################
######            CONFIGURATION            ######
#################################################
UTC_HOUR_TO_POST = 22
NAME_OF_PERIOD = "2026.1"
START_DATE = "2026-03-09"
END_DATE = "2026-10-31"
# Próximos períodos e recessos ficam em src/config/calendar.ts.
FREEZE_DURING_BREAK=true
COMMUNITY_START_DATE=2026-10-21
# 0=domingo, 5=sexta-feira. Alterna pergunta aberta e enquete.
COMMUNITY_WEEKDAY=5
# true imprime uma prévia e encerra sem chamar a API.
DRY_RUN=false

# Publicação sem a API paga. O SDK oficial só é usado com X_PUBLISHER=official.
X_PUBLISHER=twifork
X_EXPECTED_USERNAME=contadoruerj
# Cookies da sua sessão do X. Nunca commite nem compartilhe estes valores.
X_AUTH_TOKEN=
X_CT0=
# Opcional: caminho absoluto do Python com requirements-twifork.txt instalado.
# TWIFORK_PYTHON=/home/ubuntu/uerj-twitter-counter/.venv/bin/python
# Opcional: diário persistente de tentativas. Preserve-o em deploys e reinícios.
# TWIFORK_JOURNAL_PATH=/home/ubuntu/uerj-twitter-counter/var/twifork.sqlite
# Telemetria sanitizada para o monitor externo; preserve também em deploys.
# PUBLICATION_HEALTH_PATH=/home/ubuntu/uerj-twitter-counter/var/health.json

#################################################
######  TWITTER API KEYS AND ACCESS TOKENS ######
#################################################

CONSUMER_KEY="YOUR_CONSUMER_KEY"
CONSUMER_SECRET="YOUR_CONSUMER_SECRET"

ACCESS_TOKEN="YOUR_ACCESS_TOKEN"
ACCESS_TOKEN_SECRET="YOUR_ACCESS_TOKEN_SECRET"
