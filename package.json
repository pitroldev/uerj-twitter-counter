{
  "name": "uerj-twitter-counter",
  "version": "1.0.0",
  "description": "UERJ Twitter Counter",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=18.20.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pitroldev/uerj-twitter-counter.git"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "node scripts/clean.cjs && tsc",
    "lint": "eslint src --ext .ts",
    "check": "npm run lint && npm test",
    "test": "npm run build && node --test tests/*.test.cjs && node scripts/test-python.cjs",
    "check:session": "npm run build && node dist/check-session.js",
    "preview": "npm run build && node dist/preview.js",
    "dev": "ts-node-dev --respawn --transpile-only src/dev.ts"
  },
  "author": "Petro Cardoso",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "node-schedule": "^2.1.1",
    "twitter-api-v2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/node-schedule": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^34.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^2.8.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.1.6"
  }
}
